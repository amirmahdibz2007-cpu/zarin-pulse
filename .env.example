# Optional. Without this key the product still runs; chat uses labelled demo answers.
OPENAI_API_KEY=

# Optional. Free OpenRouter models are $0; set this so /ai chat uses the live model.
# Without it, chat still answers from locked merchant artifact (grounded fallback).
# Never commit the real value — put it in .env.local or the host env (Liara/Arvan).
OPENROUTER_API_KEY=

# Optional. Absolute path to the artifacts tree (must contain platform.json).
# Useful in Docker/Liara when cwd discovery is ambiguous.
ARTIFACTS_ROOT=
